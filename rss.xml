---
layout: null
permalink: /rss.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/rss.xml" rel="self" type="application/rss+xml" />
    <description>{{ site.description | strip_html | xml_escape }}</description>
    <language>ko-KR</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% if site.logo %}
    <image>
      <url>{{ site.logo | absolute_url }}</url>
      <title>{{ site.title | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}/</link>
    </image>
    {% endif %}
    {% for post in site.posts limit: 20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ site.url }}{{ site.baseurl }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {% if post.category %}
      <category>{{ post.category | xml_escape }}</category>
      {% endif %}
      {% for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {% endfor %}
      {% if post.author %}
      <dc:creator>{{ post.author | xml_escape }}</dc:creator>
      {% elsif site.social.name %}
      <dc:creator>{{ site.social.name | xml_escape }}</dc:creator>
      {% endif %}
      <description><![CDATA[
        {% if post.excerpt %}
          {{ post.excerpt | strip_html }}
        {% else %}
          {{ post.content | strip_html | truncatewords: 50 }}
        {% endif %}
      ]]></description>
      {% if post.image %}
      <enclosure url="{{ post.image | absolute_url }}" type="image/jpeg" />
      {% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
